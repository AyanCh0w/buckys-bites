{
  "expo": {
    "name": "Bucky's Bites",
    "slug": "buckys-bites",
    "scheme": "buckysbites",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "icon": "./composer-icon/buckysbites.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.buckysbites.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Bucky's Bites",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-font",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7632b751-61fd-4093-98ec-3d5f79a3d746"
      }
    },
    "owner": "blubosss-team"
  }
}
