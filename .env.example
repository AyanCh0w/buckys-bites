# Optional client configuration. Leave these commented to use the existing
# public Supabase defaults in src/lib/supabase.ts.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Browser development enables a visual preview profile. Set this to true only
# when deliberately enabling that profile in another build.
# EXPO_PUBLIC_PREVIEW_ACCOUNT=false

# EXPO_PUBLIC_* values are embedded in the app. Never put private credentials,
# Supabase service-role keys, or signing keys here.
